{
  "name": "@botharness/pixel-banner",
  "version": "0.1.0",
  "description": "Seeded pixel-art nature banners (3:1, 1500×500) in ten scenes, as crisp RGBA pixels",
  "keywords": [
    "banner",
    "generator",
    "header",
    "pixel-art",
    "procedural",
    "profile"
  ],
  "homepage": "https://github.com/BotHarness/BotPixel",
  "bugs": {
    "url": "https://github.com/BotHarness/BotPixel/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BotHarness/BotPixel.git",
    "directory": "packages/banner"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.20.0",
    "typescript": "^5.9.3"
  }
}
