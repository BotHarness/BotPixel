{
  "name": "@botharness/pixel-avatar",
  "version": "0.4.0",
  "description": "Seeded, editable 32×32 chibi pixel avatars with state symbols that morph in and out",
  "keywords": [
    "agent-ui",
    "avatar",
    "generator",
    "identicon",
    "pixel-art",
    "svg"
  ],
  "homepage": "https://github.com/BotHarness/BotPixel",
  "bugs": {
    "url": "https://github.com/BotHarness/BotPixel/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BotHarness/BotPixel.git",
    "directory": "packages/avatar"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@botharness/pixel-morph": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "^0.20.0",
    "typescript": "^5.9.3"
