{
  "name": "@botharness/pixel-morph",
  "version": "0.1.0",
  "description": "Morph any pixel art into any other: pairing, arcs and grid-snapped frames, with an SVG renderer",
  "keywords": [
    "animation",
    "morph",
    "pixel-art",
    "svg",
    "transition"
  ],
  "homepage": "https://github.com/BotHarness/BotPixel",
  "bugs": {
    "url": "https://github.com/BotHarness/BotPixel/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BotHarness/BotPixel.git",
    "directory": "packages/morph"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.20.0",
    "typescript": "^5.9.3"
  }
}
