{
  "name": "botpixel",
  "version": "0.0.0",
  "private": true,
  "description": "BotPixel — a pixel morph engine and a pixel avatar kit for agent products",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "tsc --noEmit -p packages/morph && tsc --noEmit -p packages/avatar",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "pnpm build && node scripts/readme-assets.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.50.0",
    "tsdown": "^0.20.0",
    "typescript": "7.0.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2"
}
